<% content_for :title, "RSS フィードリーダー" %>

<div class="w-full">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">RSS フィードリーダー</h1>

  <%# フィードフィルタ %>
  <div class="flex flex-wrap gap-2 mb-6">
    <%= link_to "すべて", feed_entries_path,
          class: "px-4 py-2 rounded-full text-sm font-medium #{params[:feed_source_id].blank? ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <% @feed_sources.each do |source| %>
      <%= link_to source.name, feed_entries_path(feed_source_id: source.id),
            class: "px-4 py-2 rounded-full text-sm font-medium #{params[:feed_source_id].to_s == source.id.to_s ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <% end %>
  </div>

  <%# エントリ一覧 %>
  <% if @entries.empty? %>
    <p class="text-gray-500 text-center py-12">記事がありません。</p>
  <% else %>
    <div class="space-y-4">
      <% @entries.each do |entry| %>
        <article class="bg-white rounded-lg shadow p-5 hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <h2 class="text-lg font-semibold text-gray-900 truncate">
                <%= link_to entry.title, entry.url, target: "_blank", rel: "noopener noreferrer",
                      class: "hover:text-blue-600" %>
              </h2>
              <% if entry.summary.present? %>
                <p class="mt-1 text-sm text-gray-600 line-clamp-2"><%= strip_tags(entry.summary) %></p>
              <% end %>
            </div>
          </div>
          <div class="mt-3 flex items-center gap-3 text-xs text-gray-500">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-medium">
              <%= entry.feed_source.name %>
            </span>
            <% if entry.published_at.present? %>
              <time datetime="<%= entry.published_at.iso8601 %>">
                <%= entry.published_at.strftime("%Y年%m月%d日") %>
              </time>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
